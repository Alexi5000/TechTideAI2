# Backend (Fastify). Copy to backend/.env. Every value is optional unless noted;
# defaults come from backend/src/config/env.ts. Never commit real keys.

NODE_ENV=development
HOST=0.0.0.0
PORT=4050
CORS_ORIGIN=http://localhost:5180

# Model providers. At least one key is needed for live agent runs and evals.
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase (run_events, approvals, eval runs). Without these the backend uses in-memory stores.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Weaviate vector memory (knowledge tools).
WEAVIATE_URL=
WEAVIATE_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNOWLEDGE_CHUNK_WORDS=200
KNOWLEDGE_CHUNK_OVERLAP_WORDS=40
KNOWLEDGE_EMBED_BATCH_SIZE=50

# Eval harness.
EVAL_REGRESSION_THRESHOLD_PCT=5
EVAL_DEFAULT_JUDGE_MODEL=gpt-4o

# Optional LangGraph (Python) sidecar, e.g. http://localhost:4051
LANGGRAPH_SIDECAR_URL=

# Approval gate.
APPROVAL_REQUIRED_TIERS=external,destructive,billing
APPROVAL_TTL_SECONDS=86400

# OpenTelemetry. Leave the endpoint empty to keep spans in-process.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=techtideai-backend
