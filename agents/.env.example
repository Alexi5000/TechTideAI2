# Agents (Mastra, TypeScript). Copy to agents/.env. Never commit real keys.

# Model used by every Mastra agent (provider/model).
MASTRA_MODEL=openai/gpt-4o
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Knowledge tools call the backend; defaults to http://localhost:4050.
BACKEND_API_BASE_URL=http://localhost:4050

# Mastra memory turns on when SUPABASE_URL is set. SUPABASE_DB_URL defaults to
# the local Supabase stack (postgresql://postgres:postgres@localhost:54322/postgres).
SUPABASE_URL=
SUPABASE_DB_URL=
